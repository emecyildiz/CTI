POSTGRES_DB=cti
POSTGRES_USER=cti_owner
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
CTI_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_N8N_PASSWORD
CTI_DASHBOARD_PASSWORD=REPLACE_WITH_THIRD_RANDOM_DASHBOARD_PASSWORD

# The first public release exposes the dashboard only on the local machine.
CTI_DASHBOARD_BIND=127.0.0.1
CTI_DASHBOARD_PORT=8080
CTI_NETWORK_NAME=cti-self-hosted
CTI_COMPOSE_PROJECT_NAME=cti-self-hosted

# Optional: enables the preflight check for an existing n8n container.
N8N_CONTAINER=

# Set to true only when using the n8n service bundled with the guided setup.
CTI_MANAGED_N8N=false
N8N_PORT=5678
N8N_TIMEZONE=UTC
N8N_ENCRYPTION_KEY=
