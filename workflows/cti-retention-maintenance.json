{
  "name": "CTI Retention Maintenance",
  "description": "Applies the reviewed CTI retention policy once per day without using AI or external messaging.",
  "active": false,
  "nodes": [
    {
      "id": "465023cf-acde-44b4-90fc-dda73335da96",
      "name": "Every Night",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 3 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "42ca11e5-eb58-42c7-a73f-4010a3bf637f",
      "name": "Manual Test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "961054cf-42f5-451d-8f97-e8ceba0f2f19",
      "name": "Apply Retention Policy",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        300,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT cti.apply_retention() AS retention_result;",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every Night": {
      "main": [
        [
          {
            "node": "Apply Retention Policy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Test": {
      "main": [
        [
          {
            "node": "Apply Retention Policy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Istanbul",
    "binaryMode": "separate",
    "availableInMCP": false,
    "timeSavedMode": "fixed",
    "errorWorkflow": "ojyQAZWnKBIKpigj",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "meta": null,
  "pinData": {},
  "tags": []
}
