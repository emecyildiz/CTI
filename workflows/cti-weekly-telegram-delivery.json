          }
        ]
      ]
    },
    "Claim Weekly Telegram Delivery": {
      "main": [
        [
          {
            "node": "Prepare Safe Telegram Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Safe Telegram Summary": {
      "main": [
        [
          {
            "node": "Send Weekly Report to Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record Preparation Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Weekly Report to Telegram": {
      "main": [
        [
          {
            "node": "Validate Telegram Receipt",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record Ambiguous Send Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Telegram Receipt": {
      "main": [
        [
          {
            "node": "Complete Telegram Delivery",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record Invalid Receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Istanbul",
    "binaryMode": "separate",
    "availableInMCP": false,
    "timeSavedMode": "fixed",
    "errorWorkflow": "ojyQAZWnKBIKpigj",
